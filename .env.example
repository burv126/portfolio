# Public site URL used for canonical links, Open Graph, sitemap, and robots.
# Use the origin only, without a trailing path. Example: https://example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional contact channels. Empty values stay hidden — the site does not invent links.
NEXT_PUBLIC_CONTACT_EMAIL=burv-vlad@mail.ru
NEXT_PUBLIC_TELEGRAM=burv_vlad
NEXT_PUBLIC_FREELANCE_URL=

# Form delivery. Set one of these and restart the server.
# Webhook wins over mailto. The secret is sent only from the server as Authorization: Bearer.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=
